rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function validCohortId(cohortId) {
      return cohortId is string && cohortId.matches('^angkatan-[0-9]{2,4}$');
    }

    function validEditableProfile(profileData) {
      return profileData.displayName is string
        && profileData.displayName.size() >= 2
        && profileData.displayName.size() <= 80
        && profileData.username is string
        && profileData.username.matches('^[a-z0-9._-]{3,24}$')
        && profileData.bio is string
        && profileData.bio.size() <= 280
        && (profileData.photoURL == null
          || (profileData.photoURL is string && profileData.photoURL.matches('^https://.*')));
    }

    function platformAdmin() {
      return profileExists() && currentProfile().role == 'platformAdmin';
    }

    function cohortAdmin(cohortId) {
      return profileExists()
        && currentProfile().role == 'cohortAdmin'
        && currentProfile().cohortId == cohortId;
    }

    function approvedCohortMember(cohortId) {
      return signedIn()
        && validCohortId(cohortId)
        && exists(/databases/$(database)/documents/membershipRequests/$(request.auth.uid + '_' + cohortId))
        && get(/databases/$(database)/documents/membershipRequests/$(request.auth.uid + '_' + cohortId)).data.status == 'approved';
    }

    function classMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && (request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.memberIds
          || approvedCohortMember(get(/databases/$(database)/documents/classes/$(classId)).data.cohortId));
    }

    function classAdmin(classId) {
      return platformAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/classes/$(classId))
          && (request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.adminIds
            || cohortAdmin(get(/databases/$(database)/documents/classes/$(classId)).data.cohortId)));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || platformAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'username', 'email', 'photoURL', 'bio', 'cohortId', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'username', 'email', 'photoURL', 'bio', 'cohortId', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'member'
        && request.resource.data.cohortId == null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validEditableProfile(request.resource.data);
      allow update: if (signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'bio', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.cohortId == resource.data.cohortId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validEditableProfile(request.resource.data))
        || (platformAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'cohortId', 'updatedAt'])
          && request.resource.data.role in ['member', 'cohortAdmin', 'platformAdmin']
          && ((request.resource.data.role == 'cohortAdmin' && validCohortId(request.resource.data.cohortId))
            || (request.resource.data.role != 'cohortAdmin' && request.resource.data.cohortId == null))
          && request.resource.data.updatedAt == request.time);
      allow delete: if platformAdmin();
    }

    match /membershipRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || platformAdmin()
          || cohortAdmin(resource.data.cohortId));
      allow create: if signedIn()
        && profileExists()
        && requestId == request.auth.uid + '_' + request.resource.data.cohortId
        && request.resource.data.userId == request.auth.uid
        && validCohortId(request.resource.data.cohortId)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['userId', 'cohortId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.cohortId == resource.data.cohortId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && ((request.auth.uid == resource.data.userId
            && resource.data.status == 'rejected'
            && request.resource.data.reviewedBy == resource.data.reviewedBy
            && request.resource.data.reviewedAt == resource.data.reviewedAt
            && request.resource.data.status == 'pending')
          || ((platformAdmin() || cohortAdmin(resource.data.cohortId))
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt == request.time));
      allow delete: if signedIn()
        && request.auth.uid == resource.data.userId
        && resource.data.status in ['pending', 'rejected'];
    }

    match /cohorts/{cohortId} {
      allow read: if true;
      allow create, delete: if platformAdmin();
      allow update: if platformAdmin()
        || (cohortAdmin(cohortId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'tagline', 'bio', 'coverImage', 'logoUrl', 'updatedAt'
          ]));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'cohortId', 'caption', 'media', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'cohortId', 'caption', 'media', 'createdAt', 'updatedAt'
        ])
        && (request.resource.data.cohortId == null || validCohortId(request.resource.data.cohortId))
        && request.resource.data.caption is string
        && request.resource.data.media is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'cohortId', 'name', 'category', 'price', 'description',
          'stock', 'status', 'imageUrl', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || platformAdmin() || cohortAdmin(resource.data.cohortId))
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || platformAdmin() || cohortAdmin(resource.data.cohortId));
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && request.resource.data.sellerId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId
        && request.resource.data.cohortId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.cohortId
        && request.resource.data.keys().hasOnly([
          'buyerId', 'sellerId', 'cohortId', 'productId', 'quantity',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || platformAdmin()
          || cohortAdmin(resource.data.cohortId));
      allow update: if signedIn()
        && (resource.data.sellerId == request.auth.uid
          || platformAdmin()
          || cohortAdmin(resource.data.cohortId))
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'processing', 'completed', 'cancelled'];
      allow delete: if platformAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create, delete: if platformAdmin();
      allow update: if platformAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'logoUrl', 'coverImage', 'updatedAt'
          ]));
    }

    match /classes/{classId} {
      allow read: if classMember(classId) || classAdmin(classId);
      allow create: if platformAdmin() || cohortAdmin(request.resource.data.cohortId);
      allow update: if classAdmin(classId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds;
      allow delete: if platformAdmin();

      match /{collectionName}/{itemId} {
        allow read: if classMember(classId) || classAdmin(classId);
        allow create, update: if classAdmin(classId)
          && collectionName in ['announcements', 'transactions', 'rules', 'schedules', 'documents'];
        allow delete: if classAdmin(classId)
          && collectionName in ['announcements', 'transactions', 'rules', 'schedules', 'documents'];
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if platformAdmin()
        || (signedIn() && cohortAdmin(request.resource.data.cohortId));
      allow update, delete: if platformAdmin()
        || (signedIn() && cohortAdmin(resource.data.cohortId));
    }

    match /follows/{followId} {
      allow read: if signedIn()
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt']);
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /media/{mediaId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || platformAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'url', 'publicId', 'resourceType', 'format', 'bytes', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || platformAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
